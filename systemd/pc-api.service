[Unit]
Description=pc-api — HTTP API for controlling this PC (input, windows, media, audio)
Documentation=https://github.com/Krodity/pc-api
After=network-online.target tailscaled.service
Wants=network-online.target
StartLimitBurst=10
StartLimitIntervalSec=120
# Fires only once restarts are exhausted, i.e. it's down for good.
OnFailure=pc-api-failed.service

[Service]
Type=simple
# User service on purpose: it injects input into this user's session and
# talks to this user's Hyprland, PipeWire and D-Bus.
# install.sh fills in %REPO%. Port: Environment=PC_API_PORT=8782
ExecStart=/usr/bin/python3 %REPO%/pc_api.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
